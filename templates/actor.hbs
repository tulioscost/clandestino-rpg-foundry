<section class="clan-vtt">
 <header class="clan-header"><div class="clan-brand">▲ CLANDESTINO <small>ARQUIVO DE OPERAÇÕES</small></div><div>{{actorType}}</div></header>
 <div class="clan-title"><button type="button" class="clan-portrait-button" data-action-clan="portrait" title="Clique para escolher uma imagem" aria-label="Alterar imagem do personagem"><img src="{{actor.img}}" alt="Retrato do ator"/><span>✎ Alterar imagem</span></button><div><h1>{{actor.name}}</h1><p>{{#if isUS}}ULTRA SENTINELA · PROJETO SIGMA-9{{else}}{{#if isMonster}}DOSSIÊ DE CONTENÇÃO{{else}}{{#if isLar}}INSTALAÇÃO / LAR{{else}}REGISTRO DE TRIPULANTE{{/if}}{{/if}}{{/if}}</p></div></div>
 {{#if isPerson}}
 <div class="clan-grid3"><label>Caminho<select data-field="path"><option value="">Escolha um Caminho</option>{{#each paths}}<option value="{{name}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Trilha<select data-field="trail"><option value="">Escolha uma Trilha</option>{{#each trails}}<option value="{{name}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Marcos<input data-field="milestones" type="number" value="{{system.milestones}}"/></label></div>
 <details class="clan-careers"><summary>Consultar Caminho e Trilha selecionados</summary><p>{{currentPathDescription}}</p><p>{{currentTrailDescription}}</p></details><div class="clan-grid3"><label>PV <input data-field="health.value" type="number" value="{{system.health.value}}"/> / {{system.health.max}} (ROB×3)</label><label>BPM <input data-field="bpm.value" type="number" value="{{system.bpm.value}}"/> <em>{{bpmStatus.label}}</em></label><label>Perícia / Equipamento <input data-field="skillBonus" type="number" value="{{system.skillBonus}}"/> / <input data-field="equipmentBonus" type="number" value="{{system.equipmentBonus}}"/></label></div>
 <div class="clan-actions"><button type="button" data-action-clan="test">🎲 Teste d6</button><button type="button" data-action-clan="attack">Ataque</button><button type="button" data-action-clan="damage">Receber dano</button><button type="button" data-action-clan="stress">+10 BPM</button><button type="button" data-action-clan="rest">−10 BPM</button></div>
 <h2>Atributos</h2><div class="clan-attrs">{{#each attributes}}<label title="{{label}}"><button type="button" class="clan-roll-attr" data-action-clan="attribute-roll" data-attribute="{{key}}" title="Rolar {{label}}">🎲 {{key}}</button><input data-field="attributes.{{key}}" type="number" min="1" max="6" value="{{value}}"/></label>{{/each}}</div>
 <h2>Perícias — graduações de 0 a 4</h2><p class="clan-hint">Distribua 8 pontos na criação (máximo 4 por perícia). Clique no nome para testar. Níveis 1–2: +1d6; 3–4: +2d6. Você pode escolher outro atributo no diálogo.</p><div class="clan-skill-grid">{{#each skillGroups}}<section class="clan-skill-group"><h3>{{code}} · {{label}}</h3>{{#each skills}}<div class="clan-skill-row"><button type="button" data-action-clan="skill-roll" data-attribute="{{attribute}}" data-skill="{{key}}" title="Testar {{name}}">🎲 {{name}}</button><input type="number" min="0" max="4" data-field="skills.{{key}}" value="{{value}}" title="Graduação de {{name}}"/></div>{{/each}}</section>{{/each}}</div>
 {{#if isUS}}<h2>Interface Ultra Sentinela</h2><div class="clan-grid3"><label>Sincronia <input type="number" data-field="sync" value="{{system.sync}}"/></label><label>Blindagem <input type="number" data-field="armorProtection" value="{{system.armorProtection}}"/></label><label>Bateria <input type="number" data-field="battery.value" value="{{system.battery.value}}"/> / <input type="number" data-field="battery.max" value="{{system.battery.max}}"/></label><label>Armadura<input data-field="armorName" value="{{system.armorName}}"/></label><label>Âncora humana<input data-field="anchor" value="{{system.anchor}}"/></label><label>Cicatriz<input data-field="conversionScar" value="{{system.conversionScar}}"/></label></div><div class="clan-actions"><button type="button" data-action-clan="sync">Sincronia neural (ROB + Sincronia; D2)</button></div>{{/if}}
 <h2>Vínculos e trauma</h2><div class="clan-grid2"><label>Vínculos<textarea data-field="bonds">{{system.bonds}}</textarea></label><label>Traumas<textarea data-field="trauma">{{system.trauma}}</textarea></label></div>
 {{/if}}
 {{#if isMonster}}<details class="clan-careers"><summary>Consultar Caminho e Trilha selecionados</summary><p>{{currentPathDescription}}</p><p>{{currentTrailDescription}}</p></details><div class="clan-grid3"><label>PV <input type="number" data-field="health.value" value="{{system.health.value}}"/> / <input type="number" data-field="health.max" value="{{system.health.max}}"/></label><label>Proteção<input type="number" data-field="protection" value="{{system.protection}}"/></label><label>Dados de ataque<input type="number" data-field="attackDice" value="{{system.attackDice}}"/></label><label>Dano-base<input type="number" data-field="damage" value="{{system.damage}}"/></label><label>Relógio<input type="number" data-field="clock.value" value="{{system.clock.value}}"/> / <input type="number" data-field="clock.max" value="{{system.clock.max}}"/></label></div><div class="clan-actions"><button type="button" data-action-clan="roll-monster">🎲 Ataque da ameaça</button><button type="button" data-action-clan="damage">Aplicar dano</button></div><div class="clan-grid2"><label>Vestígios<textarea data-field="clues">{{system.clues}}</textarea></label><label>Contramedidas<textarea data-field="countermeasures">{{system.countermeasures}}</textarea></label></div>{{/if}}
 {{#if isLar}}<h2>Sistemas do Lar (0–4)</h2><div class="clan-grid2"><label>Atmosfera<input type="number" min="0" max="4" data-field="resources.atmosfera" value="{{system.resources.atmosfera}}"/></label><label>Energia<input type="number" min="0" max="4" data-field="resources.energia" value="{{system.resources.energia}}"/></label><label>Estrutura<input type="number" min="0" max="4" data-field="resources.estrutura" value="{{system.resources.estrutura}}"/></label><label>Comunicação<input type="number" min="0" max="4" data-field="resources.comunicacao" value="{{system.resources.comunicacao}}"/></label></div><h2>Suprimentos</h2><div class="clan-grid3"><label>Peças<input type="number" data-field="supplies.pecas" value="{{system.supplies.pecas}}"/></label><label>Rações<input type="number" data-field="supplies.racoes" value="{{system.supplies.racoes}}"/></label><label>Medicamentos<input type="number" data-field="supplies.medicamentos" value="{{system.supplies.medicamentos}}"/></label></div><label>Setores<textarea data-field="sectors">{{system.sectors}}</textarea></label><label>Incidentes / Relógios<textarea data-field="incidents">{{system.incidents}}</textarea></label>{{/if}}
 <h2>Inventário · Carga</h2>
 {{#if isPerson}}<div class="clan-load"><strong>Carga atual: {{currentLoad}} / 4 (sem penalidade) · 6 (máximo)</strong><span>{{loadStatus}}</span><small>Carga total = quantidade × carga unitária. De 5 a 6: −1d6 em deslocamento exigente; acima de 6: excesso deve ser resolvido antes de prosseguir.</small></div>{{/if}}
 <h2>Equipamento, talentos e documentos</h2><div class="clan-actions"><button type="button" data-action-clan="new-item">+ Novo item</button></div><ul class="clan-item-list">{{#each items}}<li><b>{{name}}</b><span>{{type}} · {{system.quantity}} un. · carga {{load}}</span>{{#if system.ammoType}}{{#if system.magazineSize}}<span>🔸 {{system.ammoLoaded}}/{{system.magazineSize}}</span><button type="button" data-action-clan="reload" data-item-id="{{id}}">Recarregar</button>{{/if}}{{/if}}{{#if system.equipped}}<span>✓ Vestida</span>{{/if}}{{#if isArmor}}<button type="button" data-action-clan="equip" data-item-id="{{id}}">Vestir/Retirar</button>{{/if}}{{#if isConsumable}}<button type="button" data-action-clan="consume" data-item-id="{{id}}">Usar 1</button>{{/if}}<button type="button" data-action-clan="item-roll" data-item-id="{{id}}">🎲 Usar / Testar</button><button type="button" data-action-clan="item-edit" data-item-id="{{id}}">Editar</button><button type="button" data-action-clan="item-del" data-item-id="{{id}}">Excluir</button></li>{{/each}}</ul>
 <h2>Notas</h2><textarea class="clan-description" data-field="description">{{system.description}}</textarea>
 <footer>CLANDESTINO · HORROR ESPACIAL · SISTEMA EXPERIMENTAL</footer>
</section>
