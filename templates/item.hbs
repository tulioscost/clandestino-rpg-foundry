<section class="clan-vtt"><header class="clan-header"><div class="clan-brand">▲ CLANDESTINO <small>INVENTÁRIO</small></div><div>{{item.type}}</div></header><div class="clan-title"><img src="{{item.img}}"/><h1>{{item.name}}</h1></div><div class="clan-grid2"><label>Quantidade<input type="number" data-field="quantity" value="{{system.quantity}}"/></label><label>Peso<input type="number" data-field="weight" value="{{system.weight}}"/></label></div>{{#if isWeapon}}<div class="clan-grid2"><label>Dano-base<input type="number" data-field="damage" value="{{system.damage}}"/></label><label>Penetração<input type="number" data-field="penetration" value="{{system.penetration}}"/></label><label>Alcance<input data-field="range" value="{{system.range}}"/></label></div>{{/if}}{{#if isArmor}}<div class="clan-grid2"><label>Proteção<input type="number" data-field="protection" value="{{system.protection}}"/></label><label>Bateria máxima<input type="number" data-field="batteryMax" value="{{system.batteryMax}}"/></label></div>{{/if}}<h2>Descrição e efeitos</h2><textarea class="clan-description" data-field="description">{{system.description}}</textarea></section>
