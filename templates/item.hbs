<section class="clan-vtt"><header class="clan-header"><div class="clan-brand">▲ CLANDESTINO <small>INVENTÁRIO</small></div><div>{{item.type}}</div></header><div class="clan-title"><img src="{{item.img}}"/><h1>{{item.name}}</h1></div><div class="clan-grid2"><label>Quantidade<input type="number" data-field="quantity" value="{{system.quantity}}"/></label><label>Peso<input type="number" data-field="weight" value="{{system.weight}}"/></label></div>{{#if isAmmo}}<div class="clan-grid2"><label>Código da munição<input data-field="ammoType" value="{{system.ammoType}}"/></label></div>{{/if}}{{#if isWeapon}}<div class="clan-grid2"><label>Dano-base<input type="number" data-field="damage" value="{{system.damage}}"/></label><label>Penetração<input type="number" data-field="penetration" value="{{system.penetration}}"/></label><label>Alcance<input data-field="range" value="{{system.range}}"/></label><label>Tipo de munição<input data-field="ammoType" value="{{system.ammoType}}"/></label><label>Carregador (capacidade)<input type="number" min="0" data-field="magazineSize" value="{{system.magazineSize}}"/></label><label>Munição carregada<input type="number" min="0" data-field="ammoLoaded" value="{{system.ammoLoaded}}"/></label><label>Custo por disparo<input type="number" min="1" data-field="ammoPerShot" value="{{system.ammoPerShot}}"/></label></div>{{/if}}{{#if isArmor}}<div class="clan-grid2"><label>Proteção<input type="number" data-field="protection" value="{{system.protection}}"/></label><label>Bateria máxima<input type="number" data-field="batteryMax" value="{{system.batteryMax}}"/></label><label>Vestida (0 ou 1)<input type="number" min="0" max="1" data-field="equipped" value="{{system.equipped}}"/></label></div>{{/if}}<h2>Descrição e efeitos</h2><textarea class="clan-description" data-field="description">{{system.description}}</textarea></section>
